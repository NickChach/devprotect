{
  "name": "devprotect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local package inspection with explicit evidence and coverage limits",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "devprotect": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "runtime:build": "cargo build --locked --manifest-path runtime/Cargo.toml",
    "runtime:demo": "node dist/cli.js runtime-demo"
  },
  "dependencies": {
    "@babel/parser": "8.1.2",
    "just-bash": "3.6.1"
  },
  "overrides": {
    "guarded-fetch": { "undici": "7.30.1" }
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
